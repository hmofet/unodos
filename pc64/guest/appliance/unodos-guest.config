# Kernel config fragment for the UnoDOS unovirt Linux appliance.
#
# Merged over x86_64 defconfig (see build_kernel.sh).  Everything the guest
# machine model offers is =y - there are NO modules, deliberately: the
# appliance has no module tree to load from, and a driver that exists only as
# a module is a device that silently does not work (the virtio_input lesson:
# every distro ships it =m).
#
# The machine model this must match is pc64/unovdev.c + unovdev_pc.c:
# virtio-mmio (cmdline-declared, no PCI), 8250 on COM1, 8259 PIC (nolapic),
# 8254 PIT, CMOS RTC, i8042 keyboard + aux mouse, and a linear framebuffer
# handed over in boot_params.screen_info (VIDEO_TYPE_EFI).

CONFIG_LOCALVERSION="-unodos"

# No modules: forces every driver below to be =y or absent.
# CONFIG_MODULES is not set

# --- virtio, over mmio only (the guest has no PCI) -------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y

# --- the framebuffer the host blits into a unoui window --------------------
# screen_info names VIDEO_TYPE_EFI; sysfb turns that into simple-framebuffer
# (simpledrm) when the format matches, efi-framebuffer (efifb) when not.
# Both paths are enabled so either binding gives a /dev/fb0 and a console.
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
# Not for UnoDOS, which offers no PCI at all: these let the SAME appliance
# boot under plain QEMU with a VGA, where the whole X and browser stack can
# be exercised in two minutes instead of the twenty-five a hypervisor run
# costs.  A debugging loop that slow stops being used, and every guess gets
# spent on a full run.
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- input: i8042 + PS/2, because virtio-input cannot cross virtio-mmio v2
# (config bitmap reads of arbitrary length BUG() in vm_get) ------------------
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_EVDEV=y

# --- console + early output ------------------------------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- filesystems the appliance uses ----------------------------------------
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# --- things a browser-sized userspace needs --------------------------------
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZSMALLOC=y
CONFIG_MEMCG=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SHMEM=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y

# ==========================================================================
# android: what a Waydroid container needs on top of the browser appliance
# (docs/ANDROID-APPLIANCE-PLAN.md P1).  All =y, same rule as everything
# above: the appliance has no module tree, and Waydroid's usual
# "modprobe binder_linux" step does not exist here because binder is built in.
#
# ashmem is deliberately ABSENT.  Waydroid >= 1.2.1 uses memfd, and ashmem
# was removed from mainline in 5.18 - a fragment asking for CONFIG_ASHMEM
# would merge silently and produce nothing.
# --------------------------------------------------------------------------

# --- binder, the one thing Android cannot be emulated without --------------
# CONFIG_ANDROID (the menu) was removed in 5.19; these are top-level now.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# --- the container: namespaces and cgroup v2 -------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y

# PSI is not a nicety here: Android's lmkd drives its kill decisions off
# /proc/pressure, and it is also how P1 measures whether a 1536 MB carve is
# enough rather than guessing from `free`.
CONFIG_PSI=y

# --- the container's network: veth into a bridge, NAT out the guest's own
# interface.  Waydroid puts waydroid0 behind this; the host wire still sees
# exactly one guest MAC, which is what unovdev_net.c's bridge assumes.
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_IP_ADVANCED_ROUTER=y

# --- POLICY ROUTING, WHICH IS HOW ANDROID ROUTES AT ALL --------------------
# Android does not put routes in the main table.  netd gives every network
# its own table (1000 + ifindex), marks each socket with the network it
# belongs to, and selects the table with an ip rule - which is why `ip route`
# in a WORKING Android container shows one on-link prefix and no default
# route, and why that sight is not evidence of anything.
#
# RouteController sets its IPv4 AND IPv6 rules up together, at startup,
# before any network exists, and it treats a failure of either as fatal to
# ITSELF:
#
#     E netd: Error adding IPv6 rule: Address family not supported by protocol
#     E netd: Failed to initialize RouteController (Address family not
#         supported by protocol)
#
# After that netd programs NO routes and registers NO DNS servers, for any
# network, on a guest with no IPv6 at all - and every layer above reports
# something else: ConnectivityService holds a perfectly good LinkProperties
# with a gateway and a resolver in it, the resolver answers ENONET, and
# Firefox says NS_ERROR_OFFLINE.  Two config lines, five layers of wrong
# answer, and none of them mentions IPv6.
#
# SUBTREES is here for the same reason and would have been the next failure:
# Android's IPv6 rules are source-address rules, which the IPv6 FIB refuses
# without it.
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SUBTREES=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y

# --- the xtables set NETD'S FIREWALL IS WRITTEN AGAINST --------------------
# Android does not ask politely for these.  netd builds its whole rule set
# in one `iptables-restore`, and one unknown match fails the WHOLE restore:
#
#     D Netd: iptables-restore process 114 terminated status=512
#
# status=512 is exit code 2, printed at debug level, four times at boot,
# with no clue which rule.  The kernel's own answer is shorter - ask
# /proc/net/ip_tables_matches and this kernel offered nine matches, of which
# netd's bandwidth and firewall controllers use `owner` (per-uid rules),
# `quota`, and `multiport`.  A distro kernel has all of these as modules and
# nobody notices; a =y appliance kernel has exactly what it was told to have.
#
# The consequence is not a missing firewall, it is a missing NETWORK: with
# its chains unbuilt, netd never programs the routes and DNS servers that
# ConnectivityService already holds, so Android has a lease, a gateway and a
# resolver in `dumpsys connectivity` and an EMPTY routing table 1003.
#
# IPv6 IS HERE BECAUSE netd RUNS ip6tables-restore TOO, and it failed
# identically.  There is no IPv6 on this bridge and there does not need to
# be: the tables have to EXIST for the restore to succeed.
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_U32=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_HELPER=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
# CHECKSUM is the one waydroid-net.sh's IPTABLES path needs for DHCP; the
# appliance takes the nftables path instead (apps/android.app says why), so
# this is here to stop that fallback being a trap for the next reader.
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_REJECT=y

# --- eBPF, WITHOUT WHICH ANDROID HAS NO DNS ------------------------------
# This is not an optimisation and it is not observability.  Android 13's
# netd tags every socket through a BPF program and its resolver refuses to
# query on an untagged socket, so a kernel without the bpf syscall gives an
# Android that gets a DHCP lease, shows an IP address in `waydroid status`,
# and cannot resolve a name.  What it says, three layers down:
#
#     E BpfHandler: Failed to get current configuration: Function not
#         implemented, fd: -1
#     W resolv  : Failed to tag socket: Function not implemented
#     D NetworkMonitor/100: PROBE_DNS www.google.com FAIL ... resNetworkQuery
#         failed: ENONET (Machine is not on the network)
#
# and what the user sees is Firefox's dinosaur-with-a-plug page saying
# NS_ERROR_OFFLINE - on a guest whose own `wget` fetches pages fine.  Nothing
# in that chain names BPF except the one netd line.
#
# CGROUP_BPF is the half that matters as much as the syscall: netd attaches
# its accounting programs to cgroups, not to sockets directly.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y

# INET_DIAG is the smaller sibling of the same story: netd's TcpSocketMonitor
# polls socket state through it every thirty seconds and logs `Failed to poll
# TCP socket info: No such file or directory` without it.  Harmless on its
# own, and it fills the log that the BPF fault has to be found in.
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y

# --- sound, for P6 (virtio-snd).  Built now rather than later because a
# kernel rebuild is fifteen minutes and a second one buys nothing: the
# driver is inert until the host presents the device.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_VIRTIO=y

# --- Android's own filesystem expectations ---------------------------------
CONFIG_TMPFS_XATTR=y
CONFIG_FUSE_FS=y
