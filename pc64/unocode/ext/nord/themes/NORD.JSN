{
    "name": "Nord",
    "type": "dark",
    "colors": {
        "editor.background": "#2E3440",
        "editor.foreground": "#D8DEE9",
        "editorLineNumber.foreground": "#4C566A",
        "editorLineNumber.activeForeground": "#D8DEE9",
        "editor.selectionBackground": "#434C5E",
        "editor.lineHighlightBackground": "#3B4252",
        "editorCursor.foreground": "#D8DEE9",
        "editorIndentGuide.background": "#434C5E",
        "editor.findMatchBackground": "#5E81AC",
        "sideBar.background": "#2E3440",
        "sideBar.foreground": "#D8DEE9",
        "sideBarSectionHeader.background": "#3B4252",
        "activityBar.background": "#3B4252",
        "activityBar.foreground": "#D8DEE9",
        "activityBarBadge.background": "#88C0D0",
        "activityBarBadge.foreground": "#2E3440",
        "statusBar.background": "#3B4252",
        "statusBar.foreground": "#D8DEE9",
        "titleBar.activeBackground": "#2E3440",
        "editorGroupHeader.tabsBackground": "#2E3440",
        "tab.activeBackground": "#3B4252",
        "tab.activeForeground": "#ECEFF4",
        "tab.inactiveBackground": "#2E3440",
        "tab.inactiveForeground": "#7B88A1",
        "tab.activeBorderTop": "#88C0D0",
        "panel.background": "#2E3440",
        "panel.border": "#434C5E",
        "terminal.background": "#2E3440",
        "terminal.foreground": "#D8DEE9",
        "terminal.ansiGreen": "#A3BE8C",
        "terminal.ansiRed": "#BF616A",
        "list.activeSelectionBackground": "#434C5E",
        "list.hoverBackground": "#3B4252",
        "list.highlightForeground": "#88C0D0",
        "input.background": "#3B4252",
        "editorWidget.background": "#3B4252",
        "quickInput.background": "#3B4252",
        "button.background": "#5E81AC",
        "focusBorder": "#88C0D0"
    },
    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#616E88", "fontStyle": "italic" } },
        { "scope": "string", "settings": { "foreground": "#A3BE8C" } },
        { "scope": "constant.numeric", "settings": { "foreground": "#B48EAD" } },
        { "scope": "constant.language", "settings": { "foreground": "#81A1C1" } },
        { "scope": ["keyword", "keyword.control"], "settings": { "foreground": "#81A1C1" } },
        { "scope": "keyword.operator", "settings": { "foreground": "#81A1C1" } },
        { "scope": ["storage", "storage.type"], "settings": { "foreground": "#81A1C1" } },
        { "scope": "entity.name.function", "settings": { "foreground": "#88C0D0" } },
        { "scope": "entity.name.type", "settings": { "foreground": "#8FBCBB" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#81A1C1" } },
        { "scope": "entity.other.attribute-name", "settings": { "foreground": "#8FBCBB" } },
        { "scope": "support.function", "settings": { "foreground": "#88C0D0" } },
        { "scope": "support.type", "settings": { "foreground": "#8FBCBB" } },
        { "scope": "variable", "settings": { "foreground": "#D8DEE9" } },
        { "scope": "variable.language", "settings": { "foreground": "#81A1C1" } },
        { "scope": "meta.preprocessor", "settings": { "foreground": "#5E81AC" } },
        { "scope": "invalid", "settings": { "foreground": "#BF616A" } },
        { "scope": "markup.heading", "settings": { "foreground": "#88C0D0", "fontStyle": "bold" } },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.inline.raw", "settings": { "foreground": "#A3BE8C" } }
    ]
}
