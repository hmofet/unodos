# Prevent git from converting line endings in binary files
*.img binary
*.bin binary

# Keep Unix line endings for scripts
*.sh text eol=lf
*.py text eol=lf
*.asm text eol=lf

# The guest appliance's payload, which is read ONLY by Linux.  `apps/*.app`
# is a shell fragment sourced inside the build container and it writes the
# appliance's own scripts out of its heredocs, so a CRLF checkout produces a
# rootfs whose init begins `#!/bin/sh\r` - "not found", from a file that is
# plainly there.  `unodos-guest.config` is merged by the kernel's own
# merge_config.sh, which would take the carriage return as part of the
# symbol name and silently enable nothing.  Neither is covered by *.sh, and
# neither failure would name its cause.
pc64/guest/appliance/apps/*.app text eol=lf
pc64/guest/appliance/*.config text eol=lf

# Generated contract surfaces (unogen emits LF); pin so regeneration on a
# Windows checkout with autocrlf=true doesn't churn their line endings.
unodef/gen/** text eol=lf

# Windows scripts keep Windows endings
*.ps1 text eol=crlf
*.bat text eol=crlf

# The vendored UnoCode tree matches its upstream byte for byte (see
# pc64/UNOCODE-UPSTREAM.md), and upstream pins these to LF. Without this, a
# Windows checkout holds CRLF while the committed bytes are LF, and every
# sync_unocode.py run reports all 26 files as changed when nothing has.
pc64/unocode/** text eol=lf
